# Copy to .env and fill in. Never commit .env.
# Production values go in the host's secret manager (doc 25).

# Database / storage (doc 25)
DATABASE_URL=postgresql://localhost:5432/clipping
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Sources (docs 01-04)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# LLM (docs 09, 14)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=

# Publishing apps (docs 17-20)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=

# Accounts tool (doc 24)
ALIAS_PROVIDER=addy
ALIAS_API_KEY=
OWNER_FORWARD_EMAIL=
# Used only where a platform requires a phone number
OWNER_PHONE=

# Added during the build
ALIAS_DOMAIN=            # your addy.io username subdomain, e.g. yourname.anonaddy.com
LLM_MODEL=claude-sonnet-5-5
CONTACT_EMAIL=           # shown on the policy pages
PUBLIC_BASE=             # https URL of the deployed dashboard (OAuth redirect URIs)
PUBLIC_BASE_URL=         # base for public clip URLs when no bucket is configured
ALERT_WEBHOOK_URL=       # optional push (e.g. an ntfy topic URL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
META_GRAPH_VERSION=v21.0
