# Copy to .env and fill in. Never commit .env.
# Production values go in the host's secret manager (doc 25).

# Database / storage (doc 25)
DATABASE_URL=postgresql://localhost:5432/clipping
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Sources (docs 01-04)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# LLM (docs 09, 14)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_USD=

# Publishing apps (docs 17-20)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=

# Accounts tool (doc 24)
BRAND_DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
OWNER_FORWARD_EMAIL=
# Used only where a platform requires a phone number
OWNER_PHONE=
